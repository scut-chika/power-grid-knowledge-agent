SYSTEM_NAME=Power Grid Knowledge Agent
SYSTEM_VERSION=v1.0
SECRET_KEY=replace-with-a-random-secret-at-least-32-bytes
DEBUG=False

LLM_TYPE=openai
LLM_API_BASE_URL=https://api.siliconflow.cn
LLM_API_KEY=your-llm-api-key
LLM_MODEL_NAME=your-chat-model

EMBEDDING_PROVIDER=api
EMBEDDING_API_BASE_URL=https://api.siliconflow.cn
EMBEDDING_API_KEY=your-embedding-api-key
EMBEDDING_MODEL_NAME=your-embedding-model
EMBEDDING_DIMENSION=1024

RERANKER_PROVIDER=api
RERANKER_API_BASE_URL=https://api.siliconflow.cn
RERANKER_API_KEY=your-reranker-api-key
RERANKER_MODEL_NAME=your-reranker-model

NEO4J_URI=bolt://localhost:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=your-neo4j-password
NEO4J_DATABASE=neo4j

SQLITE_DB_PATH=./data/meta.db
RETRIEVE_TOP_N=20
SPARSE_RETRIEVE_TOP_N=20
RERANK_TOP_N=10
HYBRID_RRF_K=60
SIMILARITY_THRESHOLD=0.7
MAX_CONTEXT_TOKEN=4096
CHUNK_SIZE=800
CHUNK_OVERLAP=120
SPARSE_INDEX_PATH=./data/cache/bm25_index.json

CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173,http://127.0.0.1:5173

